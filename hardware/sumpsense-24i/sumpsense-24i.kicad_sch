	(text "Zwei ATtiny1616 am I2C (Löcher J1). U1: 12 Stufen, Adresse 0x78 (PA3 an GND); U2: 12 Stufen, 0x77 (PA3 an VCC)." (exclude_from_sim no) (at 20.32 266.70 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "e18e0b29-7fe8-5e96-92f8-1a68da3a0bab"))
	(text "R3-R26 je 1k in Serie zu den Elektroden. E1 direkt hinter der Linie MAX, E24 an der Spitze." (exclude_from_sim no) (at 20.32 270.51 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "d2358406-d704-5363-8bfe-f99776e4d2f7"))
	(text "J1 = sechs Löcher im 2,54-mm-Raster: GND, VCC, SCL, SDA quer, UPDI U1 und U2 an der Seite (Flashen je Chip einzeln)." (exclude_from_sim no) (at 20.32 274.32 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "bc29fc7c-dddb-5a19-aac8-bf4acc71a159"))
