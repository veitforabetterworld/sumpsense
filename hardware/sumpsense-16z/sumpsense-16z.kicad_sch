	(text "J1: 5 V an Pin 5V, Magnetventil zwischen 5V und VLV. Q1 schaltet nach GND, D1 = Freilaufdiode, R23 hält das Gate aus." (exclude_from_sim no) (at 20.32 215.90 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "d40ee662-fc70-53d7-9834-c5ba3e29b779"))
	(text "U2 XC6206: 200 mA; der H2 zieht beim Senden (+20 dBm) bis 140 mA. R22 = 0-Ohm-Brücke. CHIP_EN direkt an 3,3 V." (exclude_from_sim no) (at 20.32 219.71 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "a7713ad8-6545-5619-b5bf-b42cd04aa480"))
	(text "Quarz 32 MHz: R20 = 0 Ohm (statt 24 nH), C1/C2 = 12 pF C0G. Antenne A1 = TI DN007 (Net-Tie RF/GND), R21 = 0 Ohm." (exclude_from_sim no) (at 20.32 223.52 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "f24c247d-e004-5a9e-b09f-88030e243b1d"))
