	(label "E06" (at 264.95 172.72 0) (fields_autoplaced yes) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "256891a2-bd03-59ef-86d4-2c0ae5e12928"))
	(text "J1: Lötpads GND, VLV, 5V auf der Unterseite am Antennenende; 5 V an 5V, Magnetventil zwischen 5V und VLV. Q1 schaltet nach GND, D1 = Freilaufdiode, R23 hält das Gate aus." (exclude_from_sim no) (at 20.32 215.90 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "393b6390-9a33-5f5a-8083-afac64995459"))
	(text "U2 XC6206: 200 mA; das Modul zieht beim Senden bis 140 mA. C4 10 uF am Modul. EN: R19 10k / C6 1 uF (Einschaltverzögerung)." (exclude_from_sim no) (at 20.32 219.71 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "dd99c56f-30aa-58e6-b3f1-2af9d2b39562"))
	(text "U1 ESP32-H2-MINI-1-H4S: 32-MHz-Quarz und PCB-Antenne im Modul. VBAT bleibt offen (im Modul an 3V3). Antennenende an der Platinenkante, darunter kein Kupfer." (exclude_from_sim no) (at 20.32 223.52 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "b4365cbb-1163-5c52-97b9-c331a705223a"))
	(text "R1-R16 je 100k in Serie zu den Elektroden. E1 an der Linie MAX, E16 an der Spitze. GPIO-Zuordnung der v2 siehe Netznamen." (exclude_from_sim no) (at 20.32 227.33 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "8f921bf3-dd68-501e-893f-72fa3c7ec85b"))
	(text "J3 (D+, D-) und JP1 PAIR sind Lötpads in derselben Reihe am Antennenende. PAIR mit dem GND-Pad daneben brücken = GPIO9 auf GND: 6 s = neu pairen, 12 s = Werksreset, beim Einschalten = Download." (exclude_from_sim no) (at 20.32 231.14 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "db9c9e35-925f-5141-b10f-b2e07d2f5b09"))
	(symbol (lib_id "Mechanical:MountingHole") (at 25.40 205.74 0) (unit 1) (exclude_from_sim no) (in_bom no) (on_board yes) (dnp no) (uuid "87bde72a-5d2f-57cd-a01b-6e7ac3c36139")
